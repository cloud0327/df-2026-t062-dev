{
 "about": "正解の事実（2 層目）の叩き台。2026-11-08 に Claude が作成。チームと、ケアマネの経験がある人に見てもらう前提。1 件 = 1 つの事実、23 項目の番号を 1 つ（状態の情報でないものは null）。id は元の発言の id ＋ 枝番",
 "facts": [
  {"id": "g-s0-001", "text": "令和2年11月18日に自宅で倒れ、B病院に救急搬送された。塞栓性脳梗塞と診断され入院した", "item23": 10, "who": null, "kind": "said", "from": ["s0-001"], "when": "令和2年11月18日"},
  {"id": "g-s0-002", "text": "令和2年12月3日に、リハビリ目的でCリハビリテーション病院に転院した", "item23": 10, "who": null, "kind": "said", "from": ["s0-002"], "when": "令和2年12月3日"},
  {"id": "g-s0-003a", "text": "長男と長男の嫁が地域包括支援センターに相談した", "item23": 1, "who": null, "kind": "said", "from": ["s0-003"], "when": "令和2年12月21日"},
  {"id": "g-s0-003b", "text": "要介護認定を申請した（認定調査と主治医意見書の作成が行われた）", "item23": 8, "who": null, "kind": "said", "from": ["s0-003"], "when": "令和2年12月21日以降"},
  {"id": "g-s0-004a", "text": "要介護認定の結果通知が届いた（要介護度は話に出ていない）", "item23": 8, "who": null, "kind": "said", "from": ["s0-004"], "when": "令和3年1月19日"},
  {"id": "g-s0-004b", "text": "長男の嫁が病院の医療相談員に、退院までの流れと居宅介護支援事業所の選び方を相談した", "item23": 1, "who": null, "kind": "said", "from": ["s0-004"], "when": "令和3年1月19日"},
  {"id": "g-s0-005", "text": "長男の嫁から事業所に電話で相談があった", "item23": 1, "who": null, "kind": "said", "from": ["s0-005"], "when": "令和3年1月20日"},

  {"id": "g-s1-001", "text": "本人の姓は甲斐", "item23": 1, "who": "加藤", "kind": "said", "from": ["s1-001"]},
  {"id": "g-s1-003", "text": "家族は介護保険を使うのが初めてで、制度のことはまだ分からない", "item23": 4, "who": "春子", "kind": "said", "from": ["s1-003"]},

  {"id": "g-s2-003", "text": "嫁から見て、発症から2か月でかなり良くなった", "item23": 10, "who": "春子", "kind": "said", "from": ["s2-003"]},
  {"id": "g-s2-006a", "text": "転院した当初は、車いすで介助が必要だった", "item23": 11, "who": "NS", "kind": "said", "from": ["s2-006"], "when": "転院当初（令和2年12月）"},
  {"id": "g-s2-006b", "text": "元々高血圧があり、降圧薬を内服している", "item23": 10, "who": "NS", "kind": "said", "from": ["s2-006"]},
  {"id": "g-s2-006c", "text": "1日6gの塩分制限を続けている", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-006"]},
  {"id": "g-s2-006d", "text": "血圧は上が130〜140、下が80〜90で安定している", "item23": 10, "who": "NS", "kind": "said", "from": ["s2-006"]},
  {"id": "g-s2-006e", "text": "本人も塩分制限に納得している", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-006"]},
  {"id": "g-s2-007", "text": "本人は味が薄くて物足りないときもあり、本当は味噌汁を飲みたい", "item23": 19, "who": "甲斐", "kind": "said", "from": ["s2-007"]},
  {"id": "g-s2-008a", "text": "下肢静脈血栓症を患った", "item23": 10, "who": "NS", "kind": "said", "from": ["s2-008"], "when": "平成15年"},
  {"id": "g-s2-008b", "text": "ワーファリンを服用しており、出血に注意が必要", "item23": 10, "who": "NS", "kind": "said", "from": ["s2-008"]},
  {"id": "g-s2-008c", "text": "医師から、今後も内服管理・塩分制限・リハビリなどの病状管理をしっかり行うよう言われている", "item23": 10, "who": "NS", "kind": "said", "from": ["s2-008"]},
  {"id": "g-s2-008d", "text": "十分な水分をとり、生活習慣病を予防していくことが大切（看護師の見立て）", "item23": 10, "who": "NS", "kind": "said", "from": ["s2-008"]},
  {"id": "g-s2-011a", "text": "病棟内は車いすを自分で操作して移動している", "item23": 11, "who": "NS", "kind": "said", "from": ["s2-011"]},
  {"id": "g-s2-011b", "text": "トイレには自分で行くが、転倒予防のため必ずナースコールを押してもらい、見守りをしている", "item23": 16, "who": "NS", "kind": "said", "from": ["s2-011"]},
  {"id": "g-s2-011c", "text": "夜間はセンサーマットを使っている", "item23": 11, "who": "NS", "kind": "said", "from": ["s2-011"]},
  {"id": "g-s2-012", "text": "本人は、トイレに自分で行くのは当たり前だと思っている", "item23": 16, "who": "甲斐", "kind": "said", "from": ["s2-012"]},
  {"id": "g-s2-013a", "text": "排尿は日中5〜6回、夜間1〜2回程度", "item23": 16, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013b", "text": "尿失禁はない", "item23": 16, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013c", "text": "排便は1〜2日に1回あり、下剤は使っていない", "item23": 16, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013d", "text": "床ずれなど皮膚のトラブルはない", "item23": 17, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013e", "text": "前の病院では夜間せん妄のような症状があったが、一時的だった", "item23": 20, "who": "NS", "kind": "said", "from": ["s2-013"], "when": "B病院に入院中"},
  {"id": "g-s2-013f", "text": "今は夜間せん妄のような症状は全くない", "item23": 20, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013g", "text": "配膳すれば自分で食べられる", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013h", "text": "毎食ほぼ全量食べている", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013i", "text": "左側が見えにくく、気付かずに左側の食べ物を残すことがある", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013j", "text": "病院では、食事をできるだけ右側に寄せて配膳している", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-013k", "text": "食事中のむせは改善したが、たまにある", "item23": 19, "who": "NS", "kind": "said", "from": ["s2-013"]},
  {"id": "g-s2-015", "text": "退院後の塩分制限は嫁が管理する", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-015", "s2-052"], "when": "退院後"},
  {"id": "g-s2-018a", "text": "左上下肢に軽度の麻痺が残っている", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018b", "text": "左腕に拘縮はなく、肘を少し曲げられる", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018c", "text": "腕の重さを肩で支えるため首から肩に張りがあり、バランスを崩す原因になっている", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018d", "text": "左足に拘縮はなく、歩くときは股関節・膝・足首を使ってしっかり振り出している", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018e", "text": "足関節に内反などはなく、装具は要らない", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018f", "text": "右側に負担がかかるが、体幹の筋力が戻ればバランスも良くなる見込み", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018g", "text": "左空間無視がある", "item23": 10, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-018h", "text": "本人も左空間無視を意識しており、歩くときに物にぶつかることは今のところない", "item23": 10, "who": "PT", "kind": "said", "from": ["s2-018"]},
  {"id": "g-s2-019", "text": "本人は退院後もリハビリを続けたい", "item23": 7, "who": "加藤", "kind": "said", "from": ["s2-019"]},
  {"id": "g-s2-020a", "text": "病院では歩行訓練などに意欲的に取り組んでいる", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-020"]},
  {"id": "g-s2-020b", "text": "退院後は、環境を整えながら、状況に合わせた体の使い方・身のこなしを身につける必要がある（PT）", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-020"]},
  {"id": "g-s2-020c", "text": "今後は体力・筋力の回復が中心で、普段からできるだけ活動的に過ごすことが大切（PT）", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-020"]},
  {"id": "g-s2-021", "text": "本人は、長い距離は転びそうでまだ不安", "item23": 11, "who": "甲斐", "kind": "said", "from": ["s2-021"]},
  {"id": "g-s2-022a", "text": "家の中はバリアフリーに改築してある", "item23": 22, "who": "春子", "kind": "said", "from": ["s2-022"]},
  {"id": "g-s2-022b", "text": "嫁は、本人が転びそうで心配している", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-022"]},
  {"id": "g-s2-022c", "text": "嫁は、本人が家のお風呂に入れるかを心配しており、入れるようになってほしい", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-022"]},
  {"id": "g-s2-022d", "text": "嫁は入浴を手伝うつもりでいる", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-022"]},
  {"id": "g-s2-023", "text": "本人は、もっとしっかり歩けるようになりたい", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-023"]},
  {"id": "g-s2-025a", "text": "歩くときは、手すりや4点杖など手で支えるところが固定されるものが安全", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-025"]},
  {"id": "g-s2-025b", "text": "疲れるとすり足になりやすい", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-025"]},
  {"id": "g-s2-025c", "text": "自宅では、カーペット・絨毯・座布団などのちょっとした段差に注意が要る", "item23": 22, "who": "OT", "kind": "said", "from": ["s2-025"]},
  {"id": "g-s2-025d", "text": "左手指に変形や拘縮はなく、ゆっくり動かせる", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-025"]},
  {"id": "g-s2-025e", "text": "左手は力がなく、物を握って持つのは難しい", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-025"]},
  {"id": "g-s2-025f", "text": "椅子に座るときは左手をテーブルやひざにのせるとバランスが取れ、肩や首の張りも少し楽になる", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-025"]},
  {"id": "g-s2-027a", "text": "左手でテーブルの上の皿や紙を押さえることはできる", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-027"]},
  {"id": "g-s2-027b", "text": "右手で箸を使って食べる、字を書く、ハンコを押すことはできる", "item23": 11, "who": "OT", "kind": "said", "from": ["s2-027"]},
  {"id": "g-s2-027c", "text": "はさみや包丁を使うのは危険なので勧めない（OT）", "item23": 12, "who": "OT", "kind": "said", "from": ["s2-027"]},
  {"id": "g-s2-028", "text": "本人は、思うように動かず一人でできないことが増えたと感じている（仕方がないとも言う）", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-028"]},
  {"id": "g-s2-029a", "text": "倒れるまでは、本人は何でも自分でやっていた", "item23": 2, "who": "春子", "kind": "said", "from": ["s2-029"], "when": "発症前"},
  {"id": "g-s2-029b", "text": "嫁は、できないところは手伝うが、自分でできることはなるべく本人にしてほしい", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-029"]},
  {"id": "g-s2-031a", "text": "言葉は転院当初に比べてかなり良くなっている", "item23": 14, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031b", "text": "舌の動きが滑らかでなく、ろれつが回りにくく、言葉が出にくい", "item23": 14, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031c", "text": "ゆっくり話し、聞き手も配慮すれば、日常の意思疎通は問題ない", "item23": 14, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031d", "text": "うまく話せずイライラすることがあり、一息入れるとスムーズに言葉が出ることがある", "item23": 14, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031e", "text": "今後はいろいろな人と会話する機会を多く持つことが大切（ST）", "item23": 14, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031f", "text": "咀嚼に大きな問題はない", "item23": 19, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031g", "text": "嚥下に大きな問題はない", "item23": 19, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031h", "text": "口の中の左側に食べ物が残ることがある", "item23": 18, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-031i", "text": "毎食後にうがいと歯磨きをしっかりしている", "item23": 18, "who": "ST", "kind": "said", "from": ["s2-031"]},
  {"id": "g-s2-032", "text": "本人は、たまに咳き込むことがあると言う", "item23": 19, "who": "甲斐", "kind": "said", "from": ["s2-032"]},
  {"id": "g-s2-034", "text": "むせても上手に吐き出せている", "item23": 19, "who": "ST", "kind": "said", "from": ["s2-034"]},
  {"id": "g-s2-036a", "text": "言語訓練より、いろいろな人と話す機会を多く持つ方が効果的（ST）", "item23": 14, "who": "ST", "kind": "said", "from": ["s2-036"]},
  {"id": "g-s2-036b", "text": "すぐに外に出るのは難しいので、息子・嫁・娘・孫とたくさん話せるとよい（ST）", "item23": 15, "who": "ST", "kind": "said", "from": ["s2-036"]},
  {"id": "g-s2-036c", "text": "本人には娘と孫がいる", "item23": 21, "who": "ST", "kind": "said", "from": ["s2-036"]},
  {"id": "g-s2-038a", "text": "食事は常食・米飯で問題ない", "item23": 19, "who": "ST", "kind": "said", "from": ["s2-038"]},
  {"id": "g-s2-038b", "text": "硬いものや大きなものは一口大に切ってよいが、細かく刻みすぎると誤嚥しやすい", "item23": 19, "who": "ST", "kind": "said", "from": ["s2-038"]},
  {"id": "g-s2-041a", "text": "本人は、脳梗塞になったのは仕方がないと受け止めている", "item23": 10, "who": "甲斐", "kind": "said", "from": ["s2-041"]},
  {"id": "g-s2-041b", "text": "倒れる前は血圧の薬を飲んでいたが、それほど気にしていなかった", "item23": 10, "who": "甲斐", "kind": "said", "from": ["s2-041"], "when": "発症前"},
  {"id": "g-s2-041c", "text": "倒れる前は仕事も家事もしていた", "item23": 2, "who": "甲斐", "kind": "said", "from": ["s2-041"], "when": "発症前"},
  {"id": "g-s2-041d", "text": "倒れる前は酒も飲んでいた", "item23": 10, "who": "甲斐", "kind": "said", "from": ["s2-041"], "when": "発症前"},
  {"id": "g-s2-041e", "text": "本人は、無理が祟ったのだろうと思うこともある", "item23": 10, "who": "甲斐", "kind": "said", "from": ["s2-041"]},
  {"id": "g-s2-041f", "text": "本人は、これからはしっかり健康管理をして健康でいたい", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-041"]},
  {"id": "g-s2-042", "text": "嫁は、何でも自分でしていた本人が病気になって一番つらいだろうと思っている", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-042"]},
  {"id": "g-s2-043", "text": "長男は、前と同じようにはいかなくても元気でいてほしい", "item23": 7, "who": "雅史", "kind": "said", "from": ["s2-043"]},
  {"id": "g-s2-045a", "text": "自宅の浴室は普通のユニットバスで、洗い場が手狭", "item23": 22, "who": "春子", "kind": "said", "from": ["s2-045"]},
  {"id": "g-s2-045b", "text": "嫁は、一緒に入って介助するのは大変だと思っている", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-045"]},
  {"id": "g-s2-046a", "text": "病院ではリハビリを兼ねて、一般家庭と同じような浴室で介助浴をしている", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-046"]},
  {"id": "g-s2-046b", "text": "入浴ではシャワーチェアを使っている", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-046"]},
  {"id": "g-s2-046c", "text": "浴槽の跨ぎ越しが大変で、介助が必要", "item23": 11, "who": "PT", "kind": "said", "from": ["s2-046"]},
  {"id": "g-s2-048a", "text": "茶碗は持てない", "item23": 19, "who": "甲斐", "kind": "said", "from": ["s2-048"]},
  {"id": "g-s2-048b", "text": "左手で皿を押さえながら、箸かスプーンで食べている", "item23": 19, "who": "甲斐", "kind": "said", "from": ["s2-048"]},
  {"id": "g-s2-048c", "text": "本人は、たまにむせるがどうってことないと言う", "item23": 19, "who": "甲斐", "kind": "said", "from": ["s2-048"]},
  {"id": "g-s2-050a", "text": "頬の裏や舌を噛むことはない", "item23": 18, "who": "甲斐", "kind": "said", "from": ["s2-050"]},
  {"id": "g-s2-050b", "text": "本人は、口の左側に食べ物が残ることを気にしていない", "item23": 18, "who": "甲斐", "kind": "said", "from": ["s2-050"]},
  {"id": "g-s2-050c", "text": "本人は、これからもおいしく食べられればいい", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-050"]},
  {"id": "g-s2-052a", "text": "退院後は嫁が3食作る", "item23": 12, "who": "春子", "kind": "said", "from": ["s2-052"], "when": "退院後"},
  {"id": "g-s2-052b", "text": "退院後は嫁が薬の管理をする", "item23": 12, "who": "春子", "kind": "said", "from": ["s2-052"], "when": "退院後"},
  {"id": "g-s2-053", "text": "面談では、ケアマネから見て普通に会話ができていた", "item23": 14, "who": "加藤", "kind": "seen", "from": ["s2-053"]},
  {"id": "g-s2-054a", "text": "本人は、今は特にしゃべりにくさを感じない（緊張しているからかもしれない）", "item23": 14, "who": "甲斐", "kind": "said", "from": ["s2-054"]},
  {"id": "g-s2-054b", "text": "本人は、ふだんは口が回らず、話が通じなくなるとイライラし、余計通じなくなることがある", "item23": 14, "who": "甲斐", "kind": "said", "from": ["s2-054"]},
  {"id": "g-s2-054c", "text": "本人は、ちゃんと話ができるようになりたい", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-054"]},
  {"id": "g-s2-055a", "text": "元々は話好きで、仕事の得意先と進んでやり取りしていた", "item23": 15, "who": "春子", "kind": "said", "from": ["s2-055"], "when": "発症前"},
  {"id": "g-s2-055b", "text": "付き合いで無尽を何本かやっていた", "item23": 15, "who": "春子", "kind": "said", "from": ["s2-055"], "when": "発症前"},
  {"id": "g-s2-055c", "text": "嫁から見て、今の状態では本人はあまり人に会いたくないようだ", "item23": 15, "who": "春子", "kind": "said", "from": ["s2-055"]},
  {"id": "g-s2-055d", "text": "嫁は、本人がまた無尽に行けるようになればいいと思っている", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-055"]},
  {"id": "g-s2-056", "text": "本人は「もう俺の出る幕はない、こんなんじゃ話もできない」と言う", "item23": 15, "who": "甲斐", "kind": "said", "from": ["s2-056"]},
  {"id": "g-s2-059a", "text": "退院後は長男夫婦と同居することに、お互い納得している", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-059"], "when": "退院後"},
  {"id": "g-s2-059b", "text": "嫁は本人と仕事で一緒だったので、同居に違和感はない", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-059"]},
  {"id": "g-s2-059c", "text": "嫁は、長男（夫）が同居を窮屈に感じるかもしれないと思っている", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-059"]},
  {"id": "g-s2-060a", "text": "長男は、同居が窮屈ということはないと言う", "item23": 21, "who": "雅史", "kind": "said", "from": ["s2-060"]},
  {"id": "g-s2-060b", "text": "長男は、これからは誰かが本人を見ていないといけないと思っている", "item23": 21, "who": "雅史", "kind": "said", "from": ["s2-060"]},
  {"id": "g-s2-061a", "text": "長男は仕事があるので、介護はほとんど嫁がする", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-061"], "when": "退院後"},
  {"id": "g-s2-061b", "text": "嫁が担うのは、食事・入浴・着替えと、必要ならトイレ", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-061"], "when": "退院後"},
  {"id": "g-s2-061c", "text": "嫁は、本人にもできることがあると見ており、介護は全然苦ではないと言う", "item23": 21, "who": "春子", "kind": "said", "from": ["s2-061"]},
  {"id": "g-s2-062", "text": "長男は仕事もあって不安だが、本人も家族も無理なくやっていきたい", "item23": 7, "who": "雅史", "kind": "said", "from": ["s2-062"]},
  {"id": "g-s2-063a", "text": "本人は、息子たちに迷惑をかけて申し訳ないと思っている", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-063"]},
  {"id": "g-s2-063b", "text": "本人は、できる限りのことは自分でやっていきたい", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-063"]},
  {"id": "g-s2-065a", "text": "本人は、朝の歯磨き・洗顔・着替えはできそうだと思っている", "item23": 11, "who": "甲斐", "kind": "said", "from": ["s2-065"]},
  {"id": "g-s2-065b", "text": "本人は、家族の手を煩わせたくないので、力をつけてしっかり歩けるようになりたい", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-065"]},
  {"id": "g-s2-067", "text": "家事は嫁に任せ、本人は手を出さない", "item23": 12, "who": "甲斐", "kind": "said", "from": ["s2-067"]},
  {"id": "g-s2-069", "text": "嫁は、本人にまた仕事で得意先とやり合ってほしいと思っている", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-069"]},
  {"id": "g-s2-070a", "text": "本人は、仕事は長男がいれば大丈夫なので自分はもういいと言う（邪魔になるだけ）", "item23": 2, "who": "甲斐", "kind": "said", "from": ["s2-070"]},
  {"id": "g-s2-070b", "text": "長男の名前は雅史（本人が名前で呼んでいる）", "item23": 21, "who": "甲斐", "kind": "said", "from": ["s2-070"]},
  {"id": "g-s2-071", "text": "長男は、まずは自分の体のことを考えてほしいと思っている", "item23": 7, "who": "雅史", "kind": "said", "from": ["s2-071"]},
  {"id": "g-s2-072a", "text": "当面は「しっかり歩くこと」「スムーズに話せること」「病気の再発を防ぐこと」を中心に取り組むことを、ケアマネが提案した", "item23": null, "who": "加藤", "kind": "judge", "from": ["s2-072"]},
  {"id": "g-s2-072b", "text": "将来は、本人だからこそできること（仕事や無尽など）をこれまでと同じように続けることを目指す（ケアマネの提案）", "item23": null, "who": "加藤", "kind": "judge", "from": ["s2-072"]},
  {"id": "g-s2-073", "text": "本人は、先のことは考えられないが、自分の体のことはしっかりやってみると言った", "item23": 7, "who": "甲斐", "kind": "said", "from": ["s2-073"]},
  {"id": "g-s2-074", "text": "嫁は、焦らずにやっていくのがいいと思っている", "item23": 7, "who": "春子", "kind": "said", "from": ["s2-074"]},

  {"id": "g-s3-001", "text": "居室〜台所〜トイレ〜居間の動線は、伝い歩きや4点杖で歩ける", "item23": 11, "who": "加藤", "kind": "seen", "from": ["s3-001"]},
  {"id": "g-s3-002a", "text": "自宅では今まで使っていたベッドで寝起きできる", "item23": 11, "who": "加藤", "kind": "seen", "from": ["s3-002"]},
  {"id": "g-s3-002b", "text": "自宅の寝具はベッド", "item23": 22, "who": "加藤", "kind": "seen", "from": ["s3-002"]},
  {"id": "g-s3-002c", "text": "起き上がりが大変なら、ベッドサイドに置き型手すりを置く", "item23": 11, "who": "加藤", "kind": "seen", "from": ["s3-002"]},
  {"id": "g-s3-003", "text": "浴室にシャワーチェアを置けば、介助や見守りのもとで安全に入浴できる", "item23": 11, "who": "加藤", "kind": "seen", "from": ["s3-003"]},
  {"id": "g-s3-004", "text": "手すりや段差解消などの住宅改修は必要ない", "item23": 22, "who": "加藤", "kind": "seen", "from": ["s3-004"]}
 ]
}
