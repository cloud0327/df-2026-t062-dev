  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch api/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch worker/index.ts",
    "start:api": "node api/index.ts",
    "start:worker": "node worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.ts --forms",
    "db:seed": "node --env-file-if-exists=.env db/seed.ts",
    "forms:check": "node forms/admin/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "vite build && node scripts/write-version.mjs",
    "preview": "vite preview",
    "forms:fetch": "node forms/tools/scripts/fetch.mjs",
    "forms:seed": "node --env-file-if-exists=.env forms/admin/seed.ts",
    "forms:assets": "node --env-file-if-exists=.env forms/admin/assets.ts",
    "forms:rebase": "node --env-file-if-exists=.env forms/admin/rebase.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.12.1",
    "@google-cloud/speech": "8.2.1",
    "@google-cloud/storage": "8.4.0",
    "@google-cloud/tasks": "7.3.1",
    "@google/genai": "3.0.0",
    "@hono/node-server": "2.1.6",
    "@pdfme/common": "6.2.8",
    "@pdfme/generator": "6.2.8",
    "@pdfme/schemas": "6.2.8",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "hono": "4.13.17",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
